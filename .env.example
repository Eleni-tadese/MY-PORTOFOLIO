# Copy to .env.local for local development, and add the same keys to your
# hosting provider's environment variables. Never commit real values.

# Postgres (Neon). Use the *pooled* connection string, with sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Admin login (single account, no sign-up)
ADMIN_EMAIL=you@example.com
# Generate with: npm run admin:hash
ADMIN_PASSWORD_HASH=
# Random string, 32+ characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Cloudinary (images, CV and demo videos). Dashboard → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
